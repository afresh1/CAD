# This should eventually be better documented,
# maybe next time I need it.
# However, it converts an svg path into a BOSL2 bezier path.


my $content = join '', <<>>;
my @paths = map { /d="(.*?)"/ ? $1 : () }
    map {s/\s+/ /rgxms} $content =~ /<\s*path\b.*?\/>/gxms;

sub path_info(@d) {
    @d = map { split /,/ } @d;
    my @info;

    my sub is_number :prototype(_) ($s)  { $s =~ /^[-+]?\d+(?:\.\d+)?$/ }

    while (@d) {
        my $inst = shift @d;
        die "Something unexpected.  Expected instruction, got $inst"
            if $inst !~ /^[A-Z]$/i;

        my %cur = (
            relative    => $inst eq lc $inst,
            instruction => $inst = uc $inst,
        );

		# M 31.197322,226.67008
		# V 115.84449
		# l 14.469143,-0.31685 3.677488,-63.828558
		# c 154.417767,-32.486267 312.240037,-36.763841 475.015577,0
		# l 3.9878,64.252218
		# h 15.42078
		# V 225.16917
		# C 364.02942,334.05936 194.22343,321.73439 31.197322,226.67008
		# Z

        while (@d && $d[0] !~ /^[A-Z]$/i) {
            my %c;
            if ($inst eq 'M' or $inst eq 'L') {
                @c{qw< x y >} = splice @d, 0, 2;
            }
            elsif ($inst eq 'H' or $inst eq 'V') {
                my $k = $inst eq 'H' ? 'x' : 'y';
                $c{$k} = shift @d;
            }
            elsif ($inst eq 'C') {
                @c{qw< x1 y1 x2 y2 x y >} = splice @d, 0, 6;
            }
            else {
                warn "Unable to parse instruction $inst";
                return @info;
            }
            unless ( all { is_number } values %c ) {
                my $c = join ", ", map { "$_: $c{$_}" } sort keys %c;
                die "$inst: $c invalid";
            }

            push @info, { %cur, %c };
        }
    }

    return @info
}

sub normalize_path($path) {
    my @path;

    foreach my $c ($path->@*) {
        my %p = @path ? $path[-1]->%* : ( x => 0, y => 0 );

        my %c = $c->%*;
        push @path, \%c;

		#$c{"relative_to"} = "$p{x},$p{y}";

        foreach my $k (qw< x y >) {
            my $v = $p{$k} // 0;

            if ( $c{relative} ) {
                foreach my $kk ( $k, "${k}1", "${k}2" ) {
                    next unless exists $c{$kk};
					#$c{$kk . "_relative"} = "$c{$kk} + $v";
                    $c{$kk} += $v;
                }
            }

            # If we didn't have a current value,
            # it means we "inherit" the previous value
            $c{$k} //= $p{$k};
        }

        $c{instruction} = 'L'
            if $c->{instruction} eq 'H'
            or $c->{instruction} eq 'V';

        delete $c{relative};
    }

    \@path;
}

sub minimize_path($path) {
    my @path;

    my %min = (
        x => abs( min( map { $_->{x} } $path->@* ) ),
        y => abs( min( map { $_->{y} } $path->@* ) ),
    );

    foreach ($path->@*) {
        my %c = $_->%*;
        #$c{min} = \%min;

        foreach my $k (qw< x y >) {
            foreach my $kk ( $k, "${k}1", "${k}2" ) {
                next unless exists $c{$kk};

                #$c{$kk . "_before_minimize"} = $c{$kk};
                $c{$kk} -= $min{$k};
            }
        }

        push @path, \%c;
    }

    return \@path;
}

sub scale_path($path, $scale) {
    my @path;

    my %max = (
        x => abs( max( map { $_->{x} } $path->@* ) ),
        y => abs( max( map { $_->{y} } $path->@* ) ),
    );

	my %scale;
	$scale{$_} = $scale->{$_} / $max{$_} for grep { $scale->{$_} } qw< x y >;
	$scale{x} //= $scale{y};
    $scale{y} //= $scale{x};

    foreach ($path->@*) {
        my %c = $_->%*;
        #$c{man} = \%man;

        foreach my $k (qw< x y >) {
            foreach my $kk ( $k, "${k}1", "${k}2" ) {
                next unless exists $c{$kk};

                #$c{$kk . "_before_scale"} = $c{$kk};
                $c{$kk} *= $scale{$k};
            }
        }

        push @path, \%c;
    }

    return \@path;
}

sub path2scad($path) {
    my @points;
    my %prev = ( x => 0, y => 0 );
    foreach my $p ($path->@*) {
        last if $p->{instruction} eq 'Z';

        my %point = ( p => $p );

        if ($p->{instruction} eq 'C') {
            my @p = map {"        [$_->[0], $_->[1]],"} (
                [ @prev{qw< x  y >} ],
                [ $p->@{qw< x1 y1 >} ],
                [ $p->@{qw< x2 y2 >} ],
                [ $p->@{qw< x  y >} ],
            );

            $point{scad} = join "\n", "each bezier_points([", @p,
                "    ], [0:inc:1])";
        }
        elsif ($p->{instruction} eq 'L' || $p->{instruction} eq 'M') {
            $point{scad} = "[$p->{x},$p->{y}]";
        }
        else {
            die "Unknown instruction: $p->{instruction}";
        }

        push @points, \%point;
        %prev = $p->%{qw< x y >};
    }

    return \@points;
}

@paths
    = map { path2scad($_) }
    #map   { scale_path( $_, { y => 119 } ) }
    map   { minimize_path($_) }
    map   { normalize_path($_) }
    map   { [ path_info( split /\s+/, $_ ) ] } @paths;

use Data::Dumper 'Dumper'; $Data::Dumper::Sortkeys = 1; $Data::Dumper::Maxdepth=4; print STDERR Dumper(@paths);
#exit;

say <<"EOL";
include <../BOSL2/std.scad>
include <../BOSL2/beziers.scad>
inc = 0.2;
EOL

foreach my $path (@paths) {
    say "polygon([";
    say "    $_->{scad}," for map { s/\n\K/    /gr } $path->@*;
    say "]);";
}
